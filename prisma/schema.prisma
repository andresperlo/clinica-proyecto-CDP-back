generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RolUsuario {
  ADMIN
  SECRETARIA
  PROFESIONAL
  MEDICO
  PROFESOR_GIMNASIO
  PACIENTE
}

enum EstadoUsuario {
  ACTIVO
  INACTIVO
  BLOQUEADO
}

enum TipoProfesional {
  MEDICO
  NUTRICIONISTA
  PSICOLOGO
  PROFESOR_GIMNASIO
  OTRO
}

enum EstadoSesion {
  ACTIVA
  REVOCADA
  VENCIDA
}

enum EstadoDispositivo {
  ACTIVO
  DESCONECTADO
  REVOCADO
}

enum EstadoSolicitudAcceso {
  PENDIENTE
  APROBADA
  COMPLETADA
  RECHAZADA
  EXPIRADA
  CANCELADA
}

enum EstadoCodigoVerificacion {
  PENDIENTE
  UTILIZADO
  EXPIRADO
  BLOQUEADO
}

enum EstadoRecuperacion {
  PENDIENTE
  APROBADA
  RECHAZADA
  COMPLETADA
  CANCELADA
}

enum TipoEventoSeguridad {
  LOGIN_EXITOSO
  LOGIN_FALLIDO
  LOGOUT
  SESION_EXPIRADA
  SESION_REVOCADA
  DISPOSITIVO_VINCULADO
  DISPOSITIVO_DESCONECTADO
  DISPOSITIVO_REVOCADO
  PRINCIPAL_DESCONECTADO
  SEGUNDO_DISPOSITIVO_SOLICITADO
  SEGUNDO_DISPOSITIVO_APROBADO
  SEGUNDO_DISPOSITIVO_RECHAZADO
  SEGUNDO_DISPOSITIVO_CANCELADO
  SOLICITUD_ACCESO_EXPIRADA
  CODIGO_EMAIL_ENVIADO
  CODIGO_EMAIL_VALIDADO
  CODIGO_EMAIL_FALLIDO
  CODIGO_EMAIL_EXPIRADO
  CODIGO_APROBACION_FALLIDO
  RECUPERACION_SOLICITADA
  RECUPERACION_APROBADA
  RECUPERACION_RECHAZADA
  PASSWORD_CAMBIADA
}

enum EstadoTurno {
  PENDIENTE
  CONFIRMADO
  CANCELADO
}

enum OrigenTurno {
  SECRETARIA
  PACIENTE
}

enum CanalTurno {
  WEB
  WHATSAPP
  SISTEMA
}

enum TipoEventoTurno {
  CREADO
  CONFIRMADO
  CANCELADO
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

enum TipoExcepcionAgenda {
  CERRADO
  HORARIO_ESPECIAL
}

model Usuario {
  id            String        @id @default(uuid()) @db.Uuid
  nombre        String
  apellido      String
  email         String        @unique
  passwordHash  String
  rol           RolUsuario    @default(PACIENTE)
  estado        EstadoUsuario @default(ACTIVO)
  creadoEn      DateTime      @default(now())
  actualizadoEn DateTime      @updatedAt
  celular       String?

  profesional         Profesional?
  sesiones            Sesion[]
  dispositivos        Dispositivo[]
  solicitudesAcceso   SolicitudAcceso[]
  codigosVerificacion CodigoVerificacion[]
  recuperaciones      SolicitudRecuperacion[]
  eventosSeguridad    EventoSeguridad[]

  controlesPesoPaciente    ControlPeso[] @relation("PacienteControlesPeso")
  controlesPesoProfesional ControlPeso[] @relation("ProfesionalControlesPeso")

  turnosPaciente          Turno[]                  @relation("PacienteTurnos")
  turnosProfesional       Turno[]                  @relation("ProfesionalTurnos")
  serviciosHabilitados    AccesoServicioPaciente[] @relation("PacienteServicios")
  serviciosHabilitadosPor AccesoServicioPaciente[] @relation("ServiciosHabilitadosPor")
  turnosCreados           Turno[]                  @relation("TurnoCreadoPor")
  eventosTurno            EventoTurno[]
  excepcionesAgendaCreadas ExcepcionAgenda[]

  @@map("usuarios")
}

model Profesional {
  id            String          @id @default(uuid()) @db.Uuid
  usuarioId     String          @unique @db.Uuid
  tipo          TipoProfesional
  matricula     String?
  activo        Boolean         @default(true)
  creadoEn      DateTime        @default(now())
  actualizadoEn DateTime        @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@map("profesionales")
}

model ControlPeso {
  id String @id @default(uuid()) @db.Uuid

  pacienteId    String @db.Uuid
  profesionalId String @db.Uuid

  pesoKg       Decimal  @db.Decimal(6, 3)
  alturaMetros Decimal? @db.Decimal(4, 2)

  fechaControl  DateTime @default(now())
  observaciones String?

  paciente    Usuario @relation("PacienteControlesPeso", fields: [pacienteId], references: [id], onDelete: Cascade)
  profesional Usuario @relation("ProfesionalControlesPeso", fields: [profesionalId], references: [id], onDelete: Restrict)

  @@index([pacienteId, fechaControl])
  @@index([profesionalId, fechaControl])
  @@map("controles_peso")
}

// Sesión lógica compartida por todos los dispositivos.
model Sesion {
  id        String       @id @default(uuid()) @db.Uuid
  usuarioId String       @db.Uuid
  estado    EstadoSesion @default(ACTIVA)

  creadoEn         DateTime  @default(now())
  venceEn          DateTime
  revocadoEn       DateTime?
  motivoRevocacion String?

  // Identificador del dispositivo principal.
  dispositivoPrincipalId  String?   @unique @db.Uuid
  principalDesconectadoEn DateTime?
  ultimoHeartbeat         DateTime?

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  // Todos los dispositivos vinculados a esta sesión.
  dispositivos Dispositivo[] @relation("SesionDispositivos")

  // Dispositivo que tiene el rol de principal.
  dispositivoPrincipal Dispositivo? @relation("DispositivoPrincipal", fields: [dispositivoPrincipalId], references: [id], onDelete: SetNull)

  // Solicitudes aprobadas desde esta sesión.
  solicitudesAprobadas SolicitudAcceso[] @relation("SolicitudAprobadaPorSesion")

  @@index([usuarioId, estado])
  @@index([venceEn])
  @@map("sesiones")
}

// Cada dispositivo tiene su propio token y comparte la sesión lógica.
model Dispositivo {
  id        String @id @default(uuid()) @db.Uuid
  usuarioId String @db.Uuid
  sesionId  String @db.Uuid

  tokenHash   String            @unique
  estado      EstadoDispositivo @default(ACTIVO)
  esPrincipal Boolean           @default(false)

  nombre           String?
  tipo             String?
  navegador        String?
  sistemaOperativo String?
  ip               String?

  creadoEn        DateTime  @default(now())
  ultimoHeartbeat DateTime?
  desconectadoEn  DateTime?
  revocadoEn      DateTime?

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  sesion  Sesion  @relation("SesionDispositivos", fields: [sesionId], references: [id], onDelete: Cascade)

  // Relación inversa: sesión en la que este dispositivo es principal.
  sesionComoPrincipal Sesion? @relation("DispositivoPrincipal")

  @@index([usuarioId, estado])
  @@index([sesionId, estado])
  @@index([sesionId, esPrincipal])
  @@map("dispositivos")
}

model SolicitudAcceso {
  id        String                @id @default(uuid()) @db.Uuid
  usuarioId String                @db.Uuid
  estado    EstadoSolicitudAcceso @default(PENDIENTE)

  dispositivo      String?
  navegador        String?
  sistemaOperativo String?
  ip               String?

  // Hash del código numérico de confirmación.
  codigoAprobacionHash    String?
  codigoAprobacionCifrado String?

  // Hash del secreto temporal que identifica la solicitud.
  challengeTokenHash String? @unique

  venceEn           DateTime
  creadaEn          DateTime  @default(now())
  emailVerificadoEn DateTime?
  aprobadaEn        DateTime?
  completadaEn      DateTime?
  rechazadaEn       DateTime?

  aprobadaPorSesionId String? @db.Uuid

  usuario          Usuario              @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  sesionAprobadora Sesion?              @relation("SolicitudAprobadaPorSesion", fields: [aprobadaPorSesionId], references: [id], onDelete: SetNull)
  codigos          CodigoVerificacion[]

  @@index([usuarioId, estado])
  @@index([venceEn])
  @@index([aprobadaPorSesionId])
  @@map("solicitudes_acceso")
}

model CodigoVerificacion {
  id                String                   @id @default(uuid()) @db.Uuid
  usuarioId         String                   @db.Uuid
  solicitudAccesoId String                   @db.Uuid
  codigoHash        String
  estado            EstadoCodigoVerificacion @default(PENDIENTE)
  intentos          Int                      @default(0)
  venceEn           DateTime
  bloqueadoHasta    DateTime?
  utilizadoEn       DateTime?
  creadoEn          DateTime                 @default(now())

  usuario         Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  solicitudAcceso SolicitudAcceso @relation(fields: [solicitudAccesoId], references: [id], onDelete: Cascade)

  @@index([usuarioId, estado])
  @@index([solicitudAccesoId, estado])
  @@index([venceEn])
  @@index([bloqueadoHasta])
  @@map("codigos_verificacion")
}

model SolicitudRecuperacion {
  id           String             @id @default(uuid()) @db.Uuid
  usuarioId    String             @db.Uuid
  estado       EstadoRecuperacion @default(PENDIENTE)
  motivo       String?
  solicitadoEn DateTime           @default(now())
  revisadoEn   DateTime?
  revisadoPor  String?            @db.Uuid
  completadoEn DateTime?

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, estado])
  @@map("solicitudes_recuperacion")
}

model EventoSeguridad {
  id          String              @id @default(uuid()) @db.Uuid
  usuarioId   String?             @db.Uuid
  tipo        TipoEventoSeguridad
  descripcion String?
  ip          String?
  dispositivo String?
  creadoEn    DateTime            @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([usuarioId, creadoEn])
  @@index([tipo, creadoEn])
  @@map("eventos_seguridad")
}

model Servicio {
  id            String   @id @default(uuid()) @db.Uuid
  nombre        String
  descripcion   String?
  codigo        String   @unique
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  accesosPaciente AccesoServicioPaciente[]
  turnos          Turno[]

  @@map("servicios")
}

model AccesoServicioPaciente {
  id         String  @id @default(uuid()) @db.Uuid
  pacienteId String  @db.Uuid
  servicioId String  @db.Uuid
  habilitado Boolean @default(true)

  habilitadoPorId String   @db.Uuid
  habilitadoEn    DateTime @default(now())
  actualizadoEn   DateTime @updatedAt

  paciente      Usuario  @relation("PacienteServicios", fields: [pacienteId], references: [id], onDelete: Cascade)
  servicio      Servicio @relation(fields: [servicioId], references: [id], onDelete: Cascade)
  habilitadoPor Usuario  @relation("ServiciosHabilitadosPor", fields: [habilitadoPorId], references: [id], onDelete: Restrict)

  @@unique([pacienteId, servicioId])
  @@index([pacienteId, habilitado])
  @@index([servicioId, habilitado])
  @@map("accesos_servicios_pacientes")
}

model Turno {
  id String @id @default(uuid()) @db.Uuid

  pacienteId    String  @db.Uuid
  servicioId    String  @db.Uuid
  profesionalId String? @db.Uuid

  fechaHora DateTime

  estado EstadoTurno @default(PENDIENTE)
  origen OrigenTurno

  creadoPorId   String?  @db.Uuid
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  paciente    Usuario  @relation("PacienteTurnos", fields: [pacienteId], references: [id], onDelete: Cascade)
  servicio    Servicio @relation(fields: [servicioId], references: [id], onDelete: Restrict)
  profesional Usuario? @relation("ProfesionalTurnos", fields: [profesionalId], references: [id], onDelete: Restrict)
  creadoPor   Usuario? @relation("TurnoCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)

  eventos EventoTurno[]

  @@index([pacienteId, fechaHora])
  @@index([profesionalId, fechaHora])
  @@index([servicioId, fechaHora])
  @@index([estado, fechaHora])
  @@map("turnos")
}

model EventoTurno {
  id String @id @default(uuid()) @db.Uuid

  turnoId   String  @db.Uuid
  usuarioId String? @db.Uuid

  tipo  TipoEventoTurno
  canal CanalTurno

  creadoEn DateTime @default(now())

  turno   Turno    @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([turnoId, creadoEn])
  @@index([usuarioId, creadoEn])
  @@map("eventos_turno")
}

model HorarioClinica {
  id String @id @default(uuid()) @db.Uuid

  diaSemana DiaSemana

  horaApertura DateTime? @db.Time(0)
  horaCierre   DateTime? @db.Time(0)

  habilitado Boolean @default(true)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@unique([diaSemana])
  @@map("horarios_clinica")
}

model ExcepcionAgenda {
  id String @id @default(uuid()) @db.Uuid

  fecha DateTime @db.Date

  tipo TipoExcepcionAgenda

  horaApertura DateTime? @db.Time(0)
  horaCierre   DateTime? @db.Time(0)

  motivo String

  creadoPorId String @db.Uuid
  creadoEn    DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  creadoPor Usuario @relation(fields: [creadoPorId], references: [id], onDelete: Restrict)

  @@unique([fecha])
  @@index([fecha])
  @@map("excepciones_agenda")
}